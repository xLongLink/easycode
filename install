#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 0 ]; then
    echo "Run install without arguments. Set UNCODE_INSTALL_DIR to change the destination." >&2
    exit 1
fi

case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=darwin ;;
    *) echo "uncode supports Linux and macOS only." >&2; exit 1 ;;
esac

case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64|arm64) arch=arm64 ;;
    *) echo "uncode supports x64 and ARM64 only." >&2; exit 1 ;;
esac

if [ "$os" = darwin ] && [ "$arch" = x64 ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || true)" = 1 ]; then
    arch=arm64
fi

target="$os-$arch"
if [ "$arch" = x64 ]; then
    if { [ "$os" = linux ] && ! grep -qwi avx2 /proc/cpuinfo; } ||
       { [ "$os" = darwin ] && [ "$(sysctl -n hw.optional.avx2_0 2>/dev/null || true)" != 1 ]; }; then
        target="$target-baseline"
    fi
fi
if [ "$os" = linux ] && { [ -f /etc/alpine-release ] || ldd --version 2>&1 | grep -qi musl; }; then
    target="$target-musl"
fi

install_dir=${UNCODE_INSTALL_DIR:-$HOME/.uncode/bin}
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/uncode_install.XXXXXXXX")
trap 'rm -rf -- "$tmp_dir"' EXIT

curl -fsSL "https://github.com/${GH_REPO:-xLongLink/uncode}/releases/latest/download/uncode-$target.tar.gz" -o "$tmp_dir/uncode.tar.gz"
tar -xzf "$tmp_dir/uncode.tar.gz" -C "$tmp_dir"
mkdir -p "$install_dir"
install -m 755 "$tmp_dir/uncode" "$install_dir/uncode"

echo "Installed uncode to $install_dir/uncode"
if [[ ":$PATH:" != *":$install_dir:"* ]]; then
    echo "Add $install_dir to your PATH to run uncode."
fi
