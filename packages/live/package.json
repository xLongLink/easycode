{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/live",
  "version": "2.0.27",
  "description": "Real-time GPT-Live voice calls on your ChatGPT subscription",
  "type": "module",
  "license": "MIT",
  "author": "M. Adel Alhashemi (https://github.com/malhashemi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xLongLink/uncode.git",
    "directory": "packages/live"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "LICENSE", "NOTICE"],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/shared/rpc.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsgo --noEmit",
    "e2e": "bun run script/e2e-call.ts"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "opusscript": "0.1.1",
    "werift": "0.25.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opencode/client": "workspace:*",
    "@opencode/theme": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@opentui/core": "catalog:"
  }
}
