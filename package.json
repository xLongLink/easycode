{
  "name": "easycode-integrations",
  "private": true,
  "type": "module",
  "scripts": {
    "up": "bun run up:text && bun run up:voice",
    "down": "bun run down:text && bun run down:voice",
    "up:text": "bash text/setup.sh install",
    "down:text": "bash text/setup.sh uninstall",
    "up:voice": "bash voice/setup.sh install",
    "down:voice": "bash voice/setup.sh uninstall",
    "test:text": "bun --cwd text test",
    "test:voice": "bun --cwd voice test",
    "check": "vp check && bun check.ts",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "echo 'Run tests inside text/ or voice/' && exit 1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "vite-plus": "1.1.0"
  },
  "packageManager": "bun@1.4.3"
}
